HOST=127.0.0.1
PORT=8766
# On your hosting service, set HOST=0.0.0.0 and APP_ORIGIN to your exact HTTPS website origin.
APP_ORIGIN=
# Public R2 custom-domain URL, e.g. https://media.example.com. Empty uses local video files.
MEDIA_CDN_BASE_URL=
# Use a private persistent disk directory for production player and score storage.
DATA_DIR=
# Set real rewards credentials through the hosting service, never in Git.
REWARDS_API_BASE=https://backend-production-082b.up.railway.app
REWARDS_API_KEY=
REWARDS_ADMIN_SECRET=
LEADERBOARD_MODE=game

# Official public policy URLs; leave empty until approved. SMS provider hooks are in membership-otp.mjs.
MEMBERSHIP_TERMS_URL=
MEMBERSHIP_PRIVACY_URL=
