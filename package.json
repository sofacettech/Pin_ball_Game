{
  "name": "sofacet-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "build": "node scripts/materialize-video.mjs && node scripts/build-frame-index.mjs && tsc --noEmit --project game-source/tsconfig.json && node scripts/build-game.mjs && node scripts/build-membership.mjs && node scripts/build-faq.mjs && node scripts/build-about.mjs && node scripts/build-account.mjs && node scripts/build-entrance.mjs",
    "build:membership": "node scripts/build-membership.mjs",
    "test:membership": "node --test tests/membership.test.mjs",
    "test:rewards": "node --test tests/membership.test.mjs tests/rewards-integration.test.mjs",
    "smoke:membership": "node scripts/browser-membership-smoke.mjs",
    "test:frontend": "node --test tests/frontend.test.mjs",
    "test:leaderboard": "node --test tests/leaderboard.test.mjs",
    "build:faq": "node scripts/build-faq.mjs",
    "build:frames": "node scripts/build-frame-index.mjs",
    "upload:videos": "node scripts/upload-r2-videos.mjs",
    "test:frames": "node --test tests/frame-cache.test.mjs",
    "build:about": "node scripts/build-about.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "build:account": "node scripts/build-account.mjs",
    "build:entrance": "node scripts/build-entrance.mjs",
    "render:entrance-video": "node scripts/render-entrance-video.mjs",
    "encode:entrance-video": "node scripts/encode-entrance-video.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "libphonenumber-js": "1.13.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "esbuild-wasm": "0.25.11",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=24"
  }
}
